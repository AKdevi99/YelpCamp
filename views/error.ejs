<% layout('layouts/bollerplate')%>
<div class="row mt-5">
  <div class="col-6 offset-3">
    <div class="alert alert-danger d-flex align-items-center justify-content-center" role="alert" style="border-radius: 10px; position: relative; overflow: hidden;">
      <!-- Background Animation -->
      <div class="alert-animation" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, rgba(255, 0, 0, 0.1), rgba(255, 0, 0, 0.2)); animation: slide 3s infinite alternate;"></div>

      <!-- Icon -->
      <div class="me-3">
        <span class="material-icons" style="font-size: 3rem; color: #ff4d4d; animation: bounce 1.5s infinite;">error</span>
      </div>

      <!-- Error Message -->
      <div>
        <h4 class="alert-heading fw-bold"><%= err.message %></h4>
        <p>Please try again or contact support if the issue persists.</p>
      </div>
    </div>
  </div>
</div>

<!-- CSS for Animations -->
<style>
  @keyframes slide {
    0% {
      transform: translateX(-10%);
    }
    100% {
      transform: translateX(10%);
    }
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
</style>

<!-- Include Google Material Icons -->
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
