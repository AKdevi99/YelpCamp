<% layout('layouts/bollerplate')%>


<div class="register-card">
    <h3 class="text-center text-dark mb-4">Login to Your Account</h3>
    <form action="/login" method="POST" class="validated-form" novalidate>
        
        <div class="mb-3">
            <label class="form-label">Username</label>
            <input type="text" class="form-control" name="username" required>
            <div class="valid-feedback">
                Looks good!
              </div>
        </div>

        <!-- Password -->
        <div class="mb-3 password-wrapper">
            <label class="form-label">Password</label>
            <input type="password" class="form-control" id="password" name="password" required>
            <span class="password-toggle" onclick="togglePassword('password')">
                <i class="fas fa-eye"></i>
            </span>
            <div class="valid-feedback">Looks good!</div>
        </div>

        <!-- Error Message -->
        <p id="errorMessage" class="text-danger text-center"></p>

        <!-- Login Button -->
        <button type="submit" class="btn btn-register w-100">Login</button>
    </form>

    <div class="text-center mt-3">
        <small>Don't have an account? <a href="/register" class="text-primary">Register</a></small>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        'use strict'

        const forms = document.querySelectorAll('.validated-form');

        Array.from(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    });

    function togglePassword(id) {
        let input = document.getElementById(id);
        if (input.type === "password") {
            input.type = "text";
        } else {
            input.type = "password";
        }
    }
</script>
