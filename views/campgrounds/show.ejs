<% layout('layouts/bollerplate')%>

<div class="row mt-3 mb-3">
    <!-- Campground Section (Left) -->
    <div class="col-md-6">
        <div class="card" style="width: 35rem;">
            <img src="<%= campground.image%>" class="card-img-top" alt="...">
            <div class="card-body">
                <h5 class="card-title"><%= campground.title %></h5>
                <p class="card-text"><%= campground.description%></p>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item text-mutted"><%= campground.location%></li>
                <li class="list-group-item">Submiited by <%= campground.author.username%></li>
                <li class="list-group-item">$<%= campground.price%>/night</li>
            </ul>
            <% if(campground.author.equals(currentUser)){ %>
                <div class="card-body">
                    <a href="/campgrounds/<%= campground._id%>/edit" class="card-link btn btn-outline-warning">Edit</a>
                    <form class="card-link d-inline" action="/campgrounds/<%= campground._id%>?_method=DELETE" method="POST">
                        <button class="btn btn-outline-danger" type="submit">Delete</button>
                    </form>
                    <a href="/campgrounds" class="card-link btn btn-outline-success">All Campgrounds</a>
                </div>
                <% } %>
            
            <div class="card-footer text-muted">
                2 days ago
            </div>
        </div>
    </div>

    <!-- Review Section (Right) -->
    <div class="col-md-6">
        <!-- Review Form -->
        <div class="card  mb-3" style="width: 30rem;">
            <div class="card-body">
                <h5 class="mb-3">Add a Review</h5>

                <!-- Star Rating System -->
                <div class="rating">
                    <input type="radio" name="review[rating]" id="star5" value="5">
                    <label for="star5" class="star">&#9733;</label>
                    <input type="radio" name="review[rating]" id="star4" value="4">
                    <label for="star4" class="star">&#9733;</label>
                    <input type="radio" name="review[rating]" id="star3" value="3">
                    <label for="star3" class="star">&#9733;</label>
                    <input type="radio" name="review[rating]" id="star2" value="2">
                    <label for="star2" class="star">&#9733;</label>
                    <input type="radio" name="review[rating]" id="star1" value="1">
                    <label for="star1" class="star">&#9733;</label>
                </div>

                <form action="/campgrounds/<%= campground._id %>/reviews" method="POST" novalidate class="validated-form" onsubmit="convertRating()">
                    <input type="hidden" id="rating" name="review[rating]" value="5"> <!-- Default rating -->

                    <div class="mb-3">
                        <label for="body" class="form-label">Your Review</label>
                        <textarea class="form-control" name="review[body]" rows="3" required></textarea>
                        <div class="valid-feedback">
                            Looks good!
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Submit Review</button>
                </form>

                <div class="mt-3">
                    <% for (let review of campground.reviews) { %>
                    <div class="mb-4">
                        <div class="card shadow-sm border-light rounded">
                            <div class="card-body">
                                <!-- <h5 class="card-title"><%= review.userName %> </h5> -->
                                <p class="card-text"><%= review.body %></p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="rating">
                                        <% for (let i = 1; i <= 5; i++) { %>
                                        <span class="star <%= i <= review.rating ? 'filled' : '' %>">&#9733;</span>
                                        <% } %>
                                    </div>
                                </div>
                                <form action="/campgrounds/<%= campground._id%>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="mt-2">
                                  <button class="btn delete-btn">&#10006;</button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>

                <script>
                    function convertRating() {
                        const rating = document.getElementById('rating').value;
                        // Convert rating to a number
                        document.getElementById('rating').value = Number(rating);
                    }
                </script>
            </div>
        </div>
    </div>
</div>

<style>

  .delete-btn {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: rgb(255, 0, 0);
    font-size: 20px;
    cursor: pointer;
    transition: color 0.3s;
}

    /* Rating stars */
    .star {
        font-size: 1.5rem;
        color: #ccc;
        transition: color 0.3s ease;
    }

    .star.filled {
        color: #f39c12;
    }

    /* Card hover effect */
    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .rating {
        display: flex;
        flex-direction: row-reverse;
        justify-content: center;
        font-size: 2rem;
    }

    .rating input {
        display: none;
    }

    .rating label {
        cursor: pointer;
        transition: transform 0.3s, color 0.3s;
        color: #ccc;
    }

    .rating label:hover,
    .rating label:hover ~ label,
    .rating input:checked ~ label {
        color: gold;
        transform: scale(1.2);
    }
</style>

<script>
    document.querySelectorAll('.rating input').forEach((star) => {
        star.addEventListener('change', (event) => {
            document.getElementById('rating').value = event.target.value;
        });
    });
</script>
